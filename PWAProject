//apps.css
/ Global State Variables
let appData = null;
let currentSession = null;
let timerInterval = null;
let secondsLeft = 0;
let isPlaying = false;

// DOM Elements
const menuContainer = document.getElementById('topics-menu');
const sessionTitle = document.getElementById('session-title');
const sessionDesc = document.getElementById('session-desc');
const timerDisplay = document.getElementById('timer-display');
const startPauseBtn = document.getElementById('start-pause-btn');
const resetBtn = document.getElementById('reset-btn');
const instructionsList = document.getElementById('instructions-list');
const audioPlayer = document.getElementById('audio-player');
const installBtn = document.getElementById('install-btn');

// 1. REGISTER SERVICE WORKER
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js')
      .then(reg => console.log('Service Worker Registered Successfully', reg.scope))
      .catch(err => console.error('Service Worker Registration Failed', err));
  });
}

// 2. CAPTURE PWA INSTALLATION EVENT
let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  installBtn.style.display = 'block'; // Make button visible
});

installBtn.addEventListener('click', async () => {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') {
      installBtn.style.display = 'none';
    }
    deferredPrompt = null;
  }
});

// 3. FETCH DATA AND INITIALIZE APP
document.addEventListener('DOMContentLoaded', () => {
  fetch('data/sessions.json')
    .then(res => res.json())
    .then(data => {
      appData = data;
      buildDynamicMenu(data.topics);
    })
    .catch(err => {
      console.error("Error loading JSON data: ", err);
      menuContainer.innerHTML = '<li><span class="dropdown-item-text text-danger">Failed to load sessions.</span></li>';
    });
});

function buildDynamicMenu(topics) {
  menuContainer.innerHTML = ''; // Reset UI
  topics.forEach(topic => {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.classList.add('dropdown-item');
    a.href = '#';
    a.textContent = `${topic.title} (${Math.floor(topic.durationSeconds / 60)} min)`;
    a.addEventListener('click', () => loadSession(topic.id));
    li.appendChild(a);
    menuContainer.appendChild(li);
  });
}

// 4. SESSION INTERACTIVE MECHANICS
function loadSession(id) {
  resetTimer();
  currentSession = appData.topics.find(t => t.id === id);
  
  if (!currentSession) return;

  // Setup Metadata UI
  sessionTitle.textContent = currentSession.title;
  sessionDesc.textContent = currentSession.description;
  secondsLeft = currentSession.durationSeconds;
  updateTimerDisplay();

  // Setup Audio Track Target
  audioPlayer.src = currentSession.audio;
  audioPlayer.load();

  // Render Array of Instructions
  instructionsList.innerHTML = '';
  currentSession.instructions.forEach(step => {
    const li = document.createElement('li');
    li.textContent = step;
    instructionsList.appendChild(li);
  });

  // Enable Interactive Triggers
  startPauseBtn.disabled = false;
  resetBtn.disabled = false;
}

function updateTimerDisplay() {
  const mins = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
  const secs = (secondsLeft % 60).toString().padStart(2, '0');
  timerDisplay.textContent = `${mins}:${secs}`;
}

// 5. TIMER STATE CONTROLLER
startPauseBtn.addEventListener('click', () => {
  if (isPlaying) {
    pauseTimer();
  } else {
    startTimer();
  }
});

resetBtn.addEventListener('click', resetTimer);
function startTimer() {
  isPlaying = true;
  startPauseBtn.textContent = 'Pause';
  startPauseBtn.classList.replace('btn-primary', 'btn-warning');
  audioPlayer.play().catch(e => console.log("Audio playback required user interaction step first: ", e));
  
  timerInterval = setInterval(() => {
    if (secondsLeft > 0) {
      secondsLeft--;
      updateTimerDisplay();
    } else {
      completeSession();
    }
  }, 1000);
}

function pauseTimer() {
  isPlaying = false;
  startPauseBtn.textContent = 'Play';
  startPauseBtn.classList.replace('btn-warning', 'btn-primary');
  audioPlayer.pause();
  clearInterval(timerInterval);
}

function resetTimer() {
  pauseTimer();
  if (currentSession) {
    secondsLeft = currentSession.durationSeconds;
    updateTimerDisplay();
  } else {
    secondsLeft = 0;
    timerDisplay.textContent = "00:00";
  }
}

function completeSession() {
  pauseTimer();
  audioPlayer.pause();
  alert("✨ Session Complete. Go forth with absolute clarity.");
  resetTimer();
}

