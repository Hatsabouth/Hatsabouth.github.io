//buttons usage
//buttons.js
// 1. Core State Variables
let timerInterval = null;  // Stores the heartbeat interval ID
let secondsLeft = 300;     // 5 minutes in seconds (default fallback)
let isPlaying = false;     // Tracks if the timer is actively running
let originalDuration = 300; // Keeps track of where to reset to

// 2. DOM Element References
const timerDisplay = document.getElementById('timer-display');
const startPauseBtn = document.getElementById('start-pause-btn');
const resetBtn = document.getElementById('reset-btn');
const audioPlayer = document.getElementById('audio-player');

// 3. Helper Function: Update the Text on the Screen
function updateTimerDisplay() {
  const minutes = Math.floor(secondsLeft / 60).toString().padStart(2, '0');
  const seconds = (secondsLeft % 60).toString().padStart(2, '0');
  timerDisplay.textContent = `${minutes}:${seconds}`;
}

// 4. Action: Start the Countdown
function startTimer() {
  isPlaying = true;
  startPauseBtn.textContent = 'Pause';
  startPauseBtn.className = 'btn btn-warning btn-lg rounded-pill px-4'; // Change Bootstrap color to yellow
  
  // Start background audio if a track is loaded
  if (audioPlayer.src) {
    audioPlayer.play().catch(err => console.log("Audio waiting for user gesture:", err));
  }

  // Create the 1-second heartbeat loop
  timerInterval = setInterval(() => {
    if (secondsLeft > 0) {
      secondsLeft--;
      updateTimerDisplay();
    } else {
      // Time ran out!
      completeSession();
    }
  }, 1000);
}

// 5. Action: Pause the Countdown
function pauseTimer() {
  isPlaying = false;
  startPauseBtn.textContent = 'Play';
  startPauseBtn.className = 'btn btn-primary btn-lg rounded-pill px-4'; // Change Bootstrap color back to blue
  
  // Pause the music
  audioPlayer.pause();
  
  // Stop the heartbeat loop
  clearInterval(timerInterval);
}

// 6. Action: Reset Everything
function resetTimer() {
  // Always pause first to stop the interval loop
  pauseTimer();
  
  // Restore original time
  secondsLeft = originalDuration;
  updateTimerDisplay();
}

// 7. Action: Timer Completion
function completeSession() {
  pauseTimer();
  alert("✨ Session finished! Take a deep breath and return smoothly to your day.");
  resetTimer();
}

// ==========================================
// 8. Event Listeners (Connecting Code to Buttons)
// ==========================================

// Handle clicks on the Start/Pause button
startPauseBtn.addEventListener('click', () => {
  if (isPlaying) {
    pauseTimer();
  } else {
    startTimer();
  }
});

// Handle clicks on the Reset button
resetBtn.addEventListener('click', resetTimer);

function loadSession(selectedTopic) {
  // Stop any timer that might currently be running
  resetTimer(); 

  // Update tracking variables with the new JSON data
  originalDuration = selectedTopic.durationSeconds;
  secondsLeft = selectedTopic.durationSeconds;
  
  // Update UI and audio target
  audioPlayer.src = selectedTopic.audio;
  updateTimerDisplay();

  // Enable buttons since a valid session is now loaded
  startPauseBtn.disabled = false;
  resetBtn.disabled = false;
}

